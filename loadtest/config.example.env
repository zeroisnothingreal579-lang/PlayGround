# Copy to my.env, fill in, then: set -a; . ./my.env; set +a
# Never commit real tokens.

BASE_URL=https://short.example.com
REGION=local
PROFILE=smoke

# Read-only test: codes file resolved relative to loadtest/k6/
CODES_FILE=../codes.txt

# Routes
# REDIRECT_PATH=/{{code}}
# STATS_PATH=/api/links/{{code}}/stats
# HEALTH_PATH=/healthz

# Link creation (leave CREATE_PATH empty for read-only)
# CREATE_PATH=/api/links
# CREATE_METHOD=POST
# CREATE_BODY='{"url":"{{url}}"}'
# CREATE_CODE_PATH=code
# CREATE_CONTENT_TYPE=application/json

# Auth
# AUTH_HEADER_NAME=Authorization
# AUTH_HEADER_VALUE='Bearer replace-me'
# COOKIE='session=replace-me'
# EXTRA_HEADERS='{"X-Api-Key":"replace-me"}'

# Load shape and budgets
# VUS=1000
# DURATION=10m
# THINK_TIME_MS=0
# MAX_FAIL_RATE=0.01
# P95_MS=400
# P99_MS=1000
# REDIRECT_P95_MS=300

# Output
# OUT_DIR=results
